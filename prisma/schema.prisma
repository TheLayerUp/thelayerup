// All money values are stored as whole rupees (Int). Razorpay amounts are
// derived by multiplying by 100 at the payment boundary.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Names match what Vercel's Neon integration sets: the pooled URL with Prisma's
  // pgbouncer flag, and the direct URL (used by migrations).
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FLAT
}

enum CustomOrderStatus {
  NEW
  QUOTED
  ACCEPTED
  IN_PRODUCTION
  COMPLETED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  // "en" or "hi": language for customer emails (set at sign-up, updated at checkout)
  locale        String    @default("en")

  // Referrals: every customer gets a shareable code; a friend who signs up with it
  // is linked here, and the referrer is rewarded once (on the friend's first paid order).
  referralCode       String?   @unique
  referredById       String?
  referredBy         User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          User[]    @relation("Referrals")
  referralRewardedAt DateTime?

  accounts          Account[]
  sessions          Session[]
  orders            Order[]
  reviews           Review[]
  addresses         Address[]
  wishlistItems     WishlistItem[]
  returns           ReturnRequest[]
  pushSubscriptions PushSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id           String    @id @default(cuid())
  name         String    @unique
  nameHi       String?
  slug         String    @unique
  description  String?
  image        String?
  emoji        String?
  displayOrder Int       @default(0)
  products     Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id             String   @id @default(cuid())
  name           String
  // Optional Hindi copy, shown when the store is switched to हिं
  nameHi         String?
  descriptionHi  String?
  slug           String   @unique
  description    String
  features       String[]
  price          Int
  compareAtPrice Int?
  stock          Int      @default(0)
  lowStockAt     Int      @default(5)
  material       String?
  color          String?
  dimensions     String?
  weightGrams    Int?
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  // Optional .glb/.gltf for the interactive 3D viewer on the product page.
  modelUrl       String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images        ProductImage[]
  orderItems    OrderItem[]
  reviews       Review[]
  wishlistItems WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model ProductImage {
  id           String  @id @default(cuid())
  url          String
  altText      String?
  displayOrder Int     @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Address {
  id        String  @id @default(cuid())
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Order {
  id           String      @id @default(cuid())
  // Human-friendly reference shown to customers, e.g. TLU-7K3QX9
  orderNumber  String      @unique
  // Language of the customer's emails for this order
  locale       String      @default("en")
  status       OrderStatus @default(PENDING)
  email        String
  subtotal     Int
  shippingCost Int         @default(0)
  discount     Int         @default(0)
  total        Int
  notes        String?

  // Address snapshot: saved addresses can change, orders must not.
  shipName    String
  shipPhone   String
  shipLine1   String
  shipLine2   String?
  shipCity    String
  shipState   String
  shipPincode String

  paymentMethod     String    @default("RAZORPAY")
  // Cash on delivery: the fee charged, and when the store confirmed the order by phone/WhatsApp.
  codFee            Int       @default(0)
  codConfirmedAt    DateTime?
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique
  paidAt            DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  couponId   String?
  coupon     Coupon? @relation(fields: [couponId], references: [id])
  couponCode String?

  items    OrderItem[]
  shipping Shipping?
  returns  ReturnRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id              String  @id @default(cuid())
  quantity        Int
  priceAtPurchase Int
  // Snapshot so order history survives product edits/deletion
  productName     String
  productImage    String?

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Shipping {
  id                String    @id @default(cuid())
  awbNumber         String?
  courierName       String?
  shiprocketOrderId String?
  status            String?
  trackingUrl       String?
  estimatedDelivery DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id                 String   @id @default(cuid())
  rating             Int
  comment            String?
  images             String[]
  isVerifiedPurchase Boolean  @default(false)
  isPublished        Boolean  @default(true)

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId])
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Int
  minOrderValue Int        @default(0)
  maxDiscount   Int?
  usageLimit    Int?
  usedCount     Int        @default(0)
  expiresAt     DateTime?
  isActive      Boolean    @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WishlistItem {
  id String @id @default(cuid())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@unique([userId, productId])
}

model ContactMessage {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String
  message String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())
}

model CustomOrder {
  id          String            @id @default(cuid())
  // CUSTOM (one-off print) or BULK (corporate / event orders)
  kind        String            @default("CUSTOM")
  company     String?
  name        String
  email       String
  phone       String
  description String
  material    String?
  quantity    Int               @default(1)
  budget      String?
  deadline    String?
  fileUrl     String?
  status      CustomOrderStatus @default(NEW)
  quotedPrice Int?
  adminNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Fixed-window rate limiting that works across serverless instances.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model ReturnRequest {
  id         String       @id @default(cuid())
  reason     String
  details    String?
  photoUrl   String?
  status     ReturnStatus @default(REQUESTED)
  adminNotes String?

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([orderId])
}

// Web push (browser notifications) for order updates.
model PushSubscription {
  id       String @id @default(cuid())
  endpoint String @unique
  p256dh   String
  auth     String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}
