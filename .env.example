# ── Database ───────────────────────────────────────────────
# Local dev: run `npm run db:local` (embedded Postgres via PGlite) and use:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"
# Production (Neon): DATABASE_URL = pooled URL (host contains -pooler), DIRECT_URL = direct URL (for migrations)
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ── Auth.js ────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Optional — enables "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Razorpay ───────────────────────────────────────────────
# Use rzp_test_ keys until launch, then switch to rzp_live_ keys. Leave blank locally for
# test-payment mode (never available in production — the server refuses to start without keys).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → https://<domain>/api/razorpay/webhook (payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# ── Email (Resend) ─────────────────────────────────────────
# Leave blank to log emails to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="TheLayerUp <orders@thelayerup.in>"   # domain must be verified in Resend
# Where new-order / custom-request / contact notifications go (optional)
STORE_NOTIFY_EMAIL=

# ── Scheduled jobs ─────────────────────────────────────────
# Vercel Cron sends this as a Bearer token to /api/cron/cleanup. Generate: openssl rand -hex 32
CRON_SECRET=

# ── Shiprocket (Phase 2 — not wired up yet) ────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000        # production: https://thelayerup.in
NEXT_PUBLIC_APP_NAME=TheLayerUp

# ── Seed (used by `npm run db:seed`) ───────────────────────
SEED_ADMIN_EMAIL=admin@thelayerup.local
SEED_ADMIN_PASSWORD=change-me-please              # 12+ chars required for non-local DBs
# Sample products are seeded only for local/CI databases unless this is true
SEED_SAMPLE_PRODUCTS=
